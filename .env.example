# 이 파일을 프로젝트 루트의 .env로 복사한 뒤 실제 값을 입력하세요.
# 이 양식에는 실제 API 키를 넣지 않습니다.
DOMEGGOOK_API_KEY=""
BASIC_AUTH_USERNAME="owner"
BASIC_AUTH_PASSWORD=""
SOURCE_MODE="live"
AI_MODE="mock"
OPENAI_API_KEY=""
# 개발 검증용 기본 모델. 모델 변경 시 가격 근거도 다시 확인하세요.
AI_TEXT_MODEL="gpt-4.1-mini"
AI_IMAGE_MODEL="gpt-image-1.5"
# 기본 SQLite 대신 PostgreSQL을 사용할 때만 DATABASE_URL을 추가하세요.
